# =============================================================================
# Civicon AI — environment template
# Copy values into frontend/.env.local and backend/.env as documented in README.
# Never put real secrets in this file. Never commit .env files.
# =============================================================================

# --- Frontend (Vite) — browser-safe keys only ---
VITE_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
VITE_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
VITE_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Backend (FastAPI) ---
PORT=8000
APP_ENV=development
FRESH_START=false
TIME_SCALE=1
SERVICE_AREA_NAME=
SERVICE_AREA_CODE=primary
DEFAULT_MAP_LAT=
DEFAULT_MAP_LNG=
EXPOSE_PASSWORD_RESET_TOKEN=false

# Firestore: set FIREBASE_PROJECT_ID and ALLOW_MEMORY_DB=false for real DB; true = in-memory (local tests only)
FIREBASE_PROJECT_ID=
ALLOW_MEMORY_DB=true

# Empty = local dev signing fallback. Production: random 32+ chars via Google Secret Manager → Cloud Run JWT_SECRET
JWT_SECRET=
JWT_ACCESS_MINUTES=20
JWT_REFRESH_DAYS=7

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GCS_BUCKET=
PUBSUB_TOPIC_EVENTS=incident-events
INTERNAL_TASK_SECRET=
PUSH_SERVICE_ACCOUNT=
INTERNAL_OIDC_AUDIENCE=
BIGQUERY_DATASET=
# Weather (backend): Google Maps Platform Weather API — separate server key (IP/unrestricted), not the browser Maps key.
GOOGLE_SERVER_API_KEY=
# Optional legacy alias; frontend uses VITE_GOOGLE_MAPS_API_KEY only.
GOOGLE_MAPS_API_KEY=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
